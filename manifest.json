{
  "manifest_version": 3,
  "name": "Webtoon Translator (Gemini)",
  "version": "1.1.0",
  "description": "Translates Korean webtoon speech bubbles on Kakao as you scroll, using the Gemini API.",
  "permissions": ["storage", "unlimitedStorage", "declarativeNetRequest"],
  "host_permissions": [
    "https://page.kakao.com/*",
    "https://webtoon.kakao.com/*",
    "https://*.kakaocdn.net/*",
    "https://*.daumcdn.net/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://page.kakao.com/*", "https://webtoon.kakao.com/*"],
      "js": ["content.js", "ui.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_page": "options.html",
  "action": { "default_title": "Webtoon Translator settings" }
}
